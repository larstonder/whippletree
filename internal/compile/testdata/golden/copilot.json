{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/bin/whippletree-hook\" run session-start --target copilot"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/bin/whippletree-hook\" run file-read --target copilot"
          }
        ]
      }
    ]
  }
}
